tools/generated/
generated/

# IDE & editor
.idea/
.vscode/
*.sublime-*

# OS junk
.DS_Store
Thumbs.db

# Docker (don't ship Docker in Docker)
Dockerfile
docker-compose*.yml
.dockerignore